# Copy this file to `server/.env` and fill in real values.
# `server/.env` is git-ignored and must never be committed.

# MongoDB connection string (e.g. from MongoDB Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
